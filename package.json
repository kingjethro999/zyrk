{
  "name": "nexu",
  "version": "0.1.8",
  "description": "Storage-efficient Node package manager: one verified store per user, shared across projects through links.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nexu": "bin/nexu.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "version:bump": "node scripts/bump-version.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "package:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "npm-package-arg": "^14.0.0",
    "npm-registry-fetch": "^20.0.1",
    "semver": "^7.8.5",
    "ssri": "^14.0.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingjethro999/nexu.git"
  },
  "bugs": {
    "url": "https://github.com/kingjethro999/nexu/issues"
  },
  "homepage": "https://github.com/kingjethro999/nexu#readme",
  "keywords": [
    "package-manager",
    "npm",
    "nodejs",
    "typescript",
    "dependency-management",
    "shared-store",
    "content-addressable-storage",
    "cli"
  ],
  "files": [
    "bin/",
    "src/",
    "VERSION",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
