{
  "name": "zyrk",
  "version": "0.7.3",
  "description": "Storage-efficient Node package manager: one verified store per user, shared across projects through links.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "zyrk": "bin/zyrk.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "version:bump": "node scripts/bump-version.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node bin/zyrk.js run build"
  },
  "dependencies": {
    "make-fetch-happen": "16.0.1",
    "npm-package-arg": "^14.0.0",
    "npm-registry-fetch": "^20.0.1",
    "semver": "^7.8.5",
    "ssri": "^14.0.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@npmcli/arborist": "10.0.3",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingjethro999/zyrk.git"
  },
  "bugs": {
    "url": "https://github.com/kingjethro999/zyrk/issues"
  },
  "homepage": "https://github.com/kingjethro999/zyrk#readme",
  "keywords": [
    "package-manager",
    "npm",
    "nodejs",
    "typescript",
    "dependency-management",
    "shared-store",
    "content-addressable-storage",
    "cli"
  ],
  "files": [
    "bin/",
    "dist/",
    "VERSION",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
