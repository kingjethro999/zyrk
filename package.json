{
  "name": "snpm",
  "version": "0.0.5",
  "private": true,
  "description": "Storage-efficient Node package manager: one verified store per user, shared across projects through links.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "version:bump": "node scripts/bump-version.js",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "npm-package-arg": "^14.0.0",
    "npm-registry-fetch": "^20.0.1",
    "semver": "^7.8.5",
    "ssri": "^14.0.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
