#!/bin/sh
set -eu

# Format what this commit touches so the tree stays gate-clean. Only files
# already staged are reformatted and restaged; everything else on disk is
# left alone.
if [ -x node_modules/.bin/prettier ]; then
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r ./node_modules/.bin/prettier --write --ignore-unknown --
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git add --
else
  echo "pre-commit: prettier is not installed; run npm install to format before committing." >&2
fi

# Check first: a broken commit must never land, and no version is spent on it.
if [ -x node_modules/.bin/tsc ]; then
  npm run check
else
  echo "pre-commit: the TypeScript toolchain is not installed; run npm install to typecheck and test before committing." >&2
fi

# The first commit records v0.0.1. Every later commit bumps the version.
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  node scripts/bump-version.js
  git add package.json package-lock.json VERSION
fi
